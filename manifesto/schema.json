          },
          "reducao_ibs_municipal": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "desc_cond_padrao": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "desc_incond_padrao": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "deducao_padrao": {
            "type": [
              "number",
              "string",
              "null"
            ],
