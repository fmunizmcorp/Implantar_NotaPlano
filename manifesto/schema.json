            "type": [
              "string",
              "null"
            ]
          },
          "classificacao_tributaria": {
            "type": [
              "string",
              "null"
            ]
          },
          "fonte_trib_aproximados": {
            "type": [
              "string",
              "null"
            ]
          },
          "discriminacao_modelo": {
            "type": [
              "string",
              "null"
            ]
          },
          "informacoes_complementares_modelo": {
            "type": [
              "string",
              "null"
            ]
          },
          "padrao_pf": {
            "type": "boolean"
          },
          "ativo": {
            "type": "boolean"
          },
          "retem_iss": {
            "type": "boolean"
          },
          "retem_pis": {
            "type": "boolean"
          },
          "retem_cofins": {
            "type": "boolean"
          },
          "retem_csll": {
            "type": "boolean"
          },
          "retem_irrf": {
            "type": "boolean"
          },
          "retem_cp": {
            "type": "boolean"
          },
          "aliq_iss": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "aliq_pis": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "aliq_cofins": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "aliq_csll": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "aliq_irrf": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "aliq_cp": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "Percentual: 2 = 2%"
          },
          "trib_aprox_federal": {
            "type": [
              "number",
              "string",
              "null"
            ],
